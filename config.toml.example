# Controlled SOL-only MEV executor configuration.
# Run target:
# cargo run --release -- --config config.toml

[rpc]
# RPC HTTP may include its API key in the URL.
http = "${RPC_HTTP_URL}"

[grpc]
enabled = true
url = "${GRPC_URL}"
x_token = "${GRPC_X_TOKEN}"

[rabbitstream]
enabled = true
url = "${RABBITSTREAM_URL}"
x_token = "${RABBITSTREAM_X_TOKEN}"

[runtime]
environment = "controlled"
# Static allowlist. May be left as `allowed_mints = []` ONLY when
# `[runtime.wallet_followers]` below is enabled with `seed_top_n > 0`; the
# boot will then derive its initial mint set from the recent trade history
# of the configured copy wallets. See docs/WALLET_SEEDING.md for the full
# runbook (pin vs non-pin, debug logs, expected boot latencies).
allowed_mints = [
  "11111111111111111111111111111111",
]

[runtime.hot_mints]
# Observability-only (M3a): when enabled, mints touched in Axion/FOMO trigger
# streams are counted BEFORE the allowlist filter, and a background task logs
# the current top_n every rotate_ms. Does NOT auto-update `allowed_mints` yet
# (that would require restarting the gRPC subscription; slated for M3b).
# Operator flow: watch logs -> pick top mints -> restart bot with updated
# `allowed_mints`.
enabled = false
top_n = 27
window_ms = 900000    # 15 minutes (must be >= rotate_ms)
rotate_ms = 300000    # 5 minutes

[runtime.promoter]
# M3b: auto-promote top-N hot mints into the runtime allowlist end-to-end
# (discovery + ATA + ALT + registry + gRPC subscription hot-swap). Seed
# (`runtime.allowed_mints`) is preserved as an invariant `A ⊇ S`.
# Requires `runtime.hot_mints.enabled=true` and `grpc.enabled=true`.
enabled = false
tick_ms = 300000              # reconciliation cadence (match hot_mints.rotate_ms)
cooling_ms = 600000           # grace after LeftTopN before demote
warmup_ms = 5000              # GrpcSubscribed -> Active fallback delay
alt_timeout_ms = 60000        # per-attempt ALT promote budget
max_lifecycle_retries = 3
top_n_target = 27             # |A| = seed ∪ top_(top_n_target − |seed|)
grpc_ack_timeout_ms = 5000
retire_ata_on_evict = false   # keep ATA rent parked on demote (recommended)
retire_alt_on_evict = false   # keep ALT slot allocated on demote

[runtime.promoter.coldstart]
# One-shot RPC scan of pump-amm signatures at boot to seed HotMintTracker
# without waiting 15 min of live trigger stream traffic.
enabled = false
max_signatures = 1000
budget_ms = 30000

[runtime.wallet_followers]
# Poll `getSignaturesForAddress` for one or more trader wallets and feed the
# mints they touched into HotMintTracker. Each new tx that hits any program
# in `programs` counts as `weight` synthetic hits, so a wallet that trades a
# mint biases the top-N heavily toward that mint on the next promoter tick.
# Requires `runtime.hot_mints.enabled=true`.
enabled = false
poll_interval_ms = 60000          # per-cycle sleep between full wallet passes
lookback_signatures = 100         # max signatures fetched per wallet per poll
weight = 20                       # synthetic hits per matched tx
programs = ["pump_amm", "dlmm"]   # aliases: pump_amm/pump, dlmm, cpmm/raydium_cpmm, damm_v2/meteora_damm_v2. Empty = accept every tx.

# --- Wallet-seeded boot (allowlist bootstrapping) ------------------------
# When `seed_top_n > 0`, the boot runs a one-shot RPC scan across every
# wallet in `[[runtime.wallet_followers.wallets]]` and picks the top-N
# most-frequently-traded mints (tie-break: most recent slot). 0 disables.
seed_top_n = 0
# true  → seeded mints join `allowed_mints` and go through the full boot
#         pipeline synchronously (discovery + ATA + ALT + registry + geyser
#         subscription). Best when the seed set is stable and small.
# false → seeded mints are planted into `HotMintTracker` via seed_boost;
#         the promoter FSM discovers them lazily on the next tick. Requires
#         `runtime.promoter.enabled=true` and `runtime.hot_mints.enabled=true`.
pin_seeded_mints = false
# Per-wallet RPC lookback for the seed scan (max 1000 per Solana's cap).
seed_max_signatures_per_wallet = 500
# Hard wall-clock cap for the whole seed scan. When exhausted the scan
# returns whatever it aggregated with a `budget_exhausted=true` log line.
seed_budget_ms = 30000
# Reserved for future parallelism (currently serial: 1 wallet at a time).
seed_concurrency = 1
# Synthetic HotMintTracker hits injected per seeded mint on the non-pin
# path. Ignored when `pin_seeded_mints=true`.
seed_boost_weight = 100

# Repeat this block for each wallet (1-3 recommended).
# [[runtime.wallet_followers.wallets]]
# address = "TraderWalletPubkeyBase58"
# label = "trader_alpha"

[axion]
enabled = true
program_id = "FLASHX8DrLbgeR8FcfNV1F5krxYcYMUdBkrP1EPBtxB9"
min_sol = 1.0
cooldown_ms = 0

[fomo]
# Set true to also treat FOMO/TradeonFomo txs as triggers. Filter is
# `signer[0] == signer_pubkey AND (touches pump-amm OR Meteora DLMM)`, so
# router changes (DFLOW / Jupiter V6 / future) don't matter.
enabled = false
signer_pubkey = "AgmLJBMDCqWynYnQiPCuj9ewsNNsBJXyzoUhD9LJzN51"
min_sol = 1.0
cooldown_ms = 0

[mev]
program_id = "MEViEnscUm6tsQRoGd9h6nLQaQspKj7DB2M5FwM3Xvz"

[wallet]
# Base58 private key, keypair file path, or env var.
private_key = "${WALLET_PRIVATE_KEY}"

[execution]
use_flashloan = true
sol_only = true
minimum_profit_lamports = 3000000
no_failure_mode = true
min_pool_base_liquidity_lamports = 1000000000
max_pool_state_age_ms = 1500
send_live_transactions = false
live_route_refresh_cooldown_ms = 1000
trigger_send_max_transactions = 1

[execution.spam]
# When enabled, rebuild `copies` variant transactions per compiled route.
# Each variant re-randomizes tip lamports/account and unit_price using the
# ranges configured in [sender.helius] and [compute]. Set ranges (min < max)
# to get distinct signatures per copy — otherwise Solana dedupes.
# Total txs sent = routes * copies (trigger_send_max_transactions is
# multiplied by copies internally so the cap doesn't accidentally clip spam).
enabled = false
copies = 1
# Micro-seconds to wait between spawning each subsequent send. 0 = all
# spawned back-to-back. Non-zero adds ordered latency but can spread
# arrivals across validator RX buffers.
stagger_us = 0

[routes]
max_dlmm_per_tx = 3

[lookup_tables]
protocol_alt = "4sKLJ1Qoudh8PJyqBeuKocYdsZvxTcRShUt9aKqwhgvC"

[lookup_tables.route_shards]
enabled = true
auto_create = true
auto_extend = true
execute_on_startup = false
state_file = "state/route_shards.json"
pending_file = "state/route_shards.pending.json"
plan_file = "state/route_shards.plan.json"
max_addresses = 256

[sender]
# `primary` picks the single provider when `broadcast=false`. Accepted values:
# "rpc" (dry-run/no live send), "helius", "nozomi", "astralan".
primary = "helius"
send_rpc = false
# When true, the bot dispatches every trigger transaction in PARALLEL to every
# provider whose block has `enabled=true`. Each provider gets its own tokio
# task and its own outcome logged (per-provider signature / latency). This is
# the "dois em simultaneo" toggle — set it to true and enable e.g. Helius +
# Nozomi to fan-out to both. When false (default) only the `primary` provider
# is used, preserving the pre-multi-sender single-provider flow.
broadcast = false

[sender.helius]
enabled = true
endpoint = "${HELIUS_SENDER_URL}"
api_key = "${HELIUS_SENDER_API_KEY}"
max_tps = 50
burst = 20
timeout_ms = 700
connection_warming_enabled = true
connection_warming_interval_ms = 5000
# Helius Sender requires both priority fee and a SOL tip.
# 1_000_000 lamports = 0.001 SOL. If min/max are set, each tx randomizes in that range.
# Use 5_000 lamports with a swqos_only endpoint for SWQOS-only.
tip_lamports = 1000000
tip_lamports_min = 1000000
tip_lamports_max = 2000000
tip_accounts = "4ACfpUFoaSD9bfPdeu6DBt89gB6ENTeHBXCAi87NhDEE,D2L6yPZ2FmmmTKPgzaMKdhu6EWZcTpLy1Vhx8uvZe7NZ,9bnz4RShgq1hAnLnZbP8kbgBg1kEmcJBYQq3gQbmnSta,5VY91ws6B2hMmBFRsXkoAAdsPHBJwRfBht4DXox3xkwn,2nyhqdwKcJZR2vcqCyrYsaPVdAnFoJjiksCXJ7hfEYgD,2q5pghRs6arqVjRvT5gfgWfWcHWmw1ZuCzphgd5KfWGJ,wyvPkWjVZz1M8fHQnMMCDTQDbkManefNNhweYk5WkcF,3KCKozbAaF75qEU33jtzozcJ29yJuaLJTy2jFdzUY8bT,4vieeGHPYPG2MmyPRcYjdiDmmhN3ww7hsFNap8pVN3Ey,4TQLFNWK8AovT1gFvda5jfw2oJeRMKEmw7aH6MGBJ3or"

[sender.nozomi]
# Temporal Nozomi SWQOS sender. Auth is via `?c=<API_KEY>` query param
# embedded directly in the endpoint URL (no separate header). Nozomi serves
# its JSON-RPC at `/`, e.g.:
#   endpoint = "https://nozomi.temporal.xyz/?c=${NOZOMI_API_KEY}"        (auto-routed)
#   endpoint = "http://fra2.nozomi.temporal.xyz/?c=${NOZOMI_API_KEY}"     (Frankfurt direct — plain HTTP recommended for lowest VPS latency)
# Nozomi rate-limits per region; to send to multiple regions in parallel run
# multiple bot instances or add regional endpoint variants (single-endpoint
# per-section for now).
enabled = false
endpoint = "${NOZOMI_SENDER_URL}"
timeout_ms = 700
# tip_lamports_min/max randomize per tx if set. Nozomi requires a SOL tip
# transferred to one of the tip_accounts below.
tip_lamports = 1000000
tip_lamports_min = 1000000
tip_lamports_max = 2000000
# Default = full official Nozomi tip account set (17 addresses). Override
# only if you want to pin to a subset.
# tip_accounts = "TEMPaMeCRFAS9EKF53Jd6KpHxgL47uWLcpFArU1Fanq,..."
connection_warming_enabled = false
connection_warming_interval_ms = 5000
# Optional health-ping URL (opt-in — Nozomi doesn't expose a standard /ping).
# ping_endpoint = ""

[sender.astralan]
# Astralane low-latency sender. Auth via `?api-key=<key>` query param — same
# convention as Helius. If the operator embeds api-key= directly in
# `endpoint`, `api_key` can be left blank.
# Endpoint patterns (see https://astralane.gitbook.io/docs/low-latency/endpoints-and-configs):
#   Global:    endpoint = "https://edge.astralane.io/iris"
#   Regional:  endpoint = "http://fr.gateway.astralane.io/iris"           # regions: fr/fr2, la, jp, ny, ams/ams2, lim, sg, lit
enabled = false
endpoint = "${ASTRALAN_SENDER_URL}"
api_key = "${ASTRALAN_SENDER_API_KEY}"
timeout_ms = 700
tip_lamports = 1000000
tip_lamports_min = 1000000
tip_lamports_max = 2000000
# Default = full documented Astralane tip account set (17 addresses).
# tip_accounts = "astrazznxsGuJEjNn98UUqQhcXFupPWobbGGpUXjw82,..."
connection_warming_enabled = false
connection_warming_interval_ms = 5000
# ping_endpoint = ""

[compute]
default_limit = 600000
# Fixed fallback. If min/max are set, each tx randomizes in that range.
# Set unit_price = 0 (and omit min/max, or set both to 0) to skip the
# SetComputeUnitPrice instruction entirely (no priority fee).
unit_price = 10000
unit_price_min = 10000
unit_price_max = 50000

[metrics]
enabled = true
file = "state/metrics.jsonl"
